#!/bin/bash
# =============================================================================
#  GKOne Prepaid Card — launcher / installer
#
#  Usage:
#     gkone                       Start the terminal app
#     gkone --web                 Start the web app (port 5000) + sync receiver (port 8765)
#     gkone --install             Install (or upgrade) to ~/.local/bin/prepaid-card
#     gkone --install --with-sync   ...and enable the Android sync receiver
#                                    as an always-on systemd user service
#     gkone --uninstall           Remove the installed program, keep your database
#     gkone --uninstall --purge-data
#                                  Remove everything, including the database
#     gkone --help                Show this help
#
#  Installing requires Python 3 with the `venv` module (Debian/Ubuntu:
#  sudo apt install python3-venv). Uses the shared venv at ~/mybankenv.
#  Safe to re-run --install to upgrade — your database is never overwritten.
# =============================================================================

APP_DIR=~/.local/bin/prepaid-card

G='\033[0;32m'; Y='\033[1;33m'; R='\033[0;31m'; C='\033[0;36m'; W='\033[1m'; N='\033[0m'
ok()   { echo -e "${G}  ✓${N} $*"; }
info() { echo -e "${C}  ℹ${N} $*"; }
warn() { echo -e "${Y}  ⚠${N} $*"; }
die()  { echo -e "${R}  ✗${N} $*" >&2; exit 1; }

usage() { sed -n '2,18p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; }

do_install() {
    set -euo pipefail
    local WITH_SYNC=0
    for arg in "$@"; do
        case "$arg" in
            --with-sync) WITH_SYNC=1 ;;
            *) die "Unknown option: $arg (see --help)" ;;
        esac
    done

    local HERE BIN_DIR VENV APPMENU_DIR PYBIN MISSING
    HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    BIN_DIR="$HOME/.local/bin"
    VENV="${MYBANKENV:-$HOME/mybankenv}"
    APPMENU_DIR="$HOME/.local/share/applications"

    echo -e "\n${W}  GKOne Prepaid Card — installer${N}"
    echo    "  ─────────────────────────────────────"

    # ── 1. Python + shared virtual environment ─────────────────────────────
    command -v python3 >/dev/null 2>&1 || die "python3 not found. Install Python 3 first."
    if [[ ! -d "$VENV" ]]; then
        info "Creating virtual environment: $VENV"
        python3 -m venv "$VENV" || die "Could not create a venv. On Debian/Ubuntu: sudo apt install python3-venv"
    fi
    PYBIN="$VENV/bin/python"

    if ! "$PYBIN" -m pip install --quiet flask rich questionary prompt_toolkit; then
        warn "Could not reach PyPI — checking what's already installed in $VENV"
    fi
    MISSING=""
    for pkg in flask rich questionary prompt_toolkit; do
        "$PYBIN" -c "import $pkg" 2>/dev/null || MISSING="$MISSING $pkg"
    done
    [[ -z "$MISSING" ]] || die "Missing Python packages in $VENV:$MISSING (no network available to install them)"
    ok "Virtual environment ready: $VENV"

    # ── 2. Application files ────────────────────────────────────────────────
    mkdir -p "$APP_DIR"
    for f in app.py prepaid_tracker.py sync_server.py sync_schema.py sync-server \
             runapp runweb initial_data.sql prepaid-sync.service README.md; do
        [[ -f "$HERE/$f" ]] && cp "$HERE/$f" "$APP_DIR/"
    done
    rm -rf "$APP_DIR/templates" "$APP_DIR/static"
    cp -r "$HERE/templates" "$APP_DIR/templates"
    cp -r "$HERE/static" "$APP_DIR/static"
    chmod +x "$APP_DIR/sync-server" "$APP_DIR/runapp" "$APP_DIR/runweb" 2>/dev/null || true
    ok "Application files: $APP_DIR"

    # Carry over an existing sync token on first install only (keeps the Android
    # app paired without re-registering it).
    if [[ -f "$HERE/.sync_token" && ! -f "$APP_DIR/.sync_token" ]]; then
        cp "$HERE/.sync_token" "$APP_DIR/.sync_token"
        chmod 600 "$APP_DIR/.sync_token"
        info "Carried over existing sync token"
    fi

    # ── 3. Database — never overwritten once installed ─────────────────────
    if [[ -f "$APP_DIR/prepaid_card.db" ]]; then
        info "Existing installed database left untouched"
    elif [[ -f "$HERE/prepaid_card.db" ]]; then
        cp "$HERE/prepaid_card.db" "$APP_DIR/prepaid_card.db"
        info "Copied your existing database into $APP_DIR"
    else
        (cd "$APP_DIR" && "$PYBIN" -c "from prepaid_tracker import init_db; init_db()")
        info "Initialized a fresh empty database (seed with initial_data.sql if wanted)"
    fi
    "$PYBIN" "$APP_DIR/sync_schema.py" >/dev/null
    ok "Database ready: $APP_DIR/prepaid_card.db"

    # ── 4. gkone launcher, on PATH ───────────────────────────────────────────
    mkdir -p "$BIN_DIR"
    cp "$HERE/gkone" "$BIN_DIR/gkone"
    chmod +x "$BIN_DIR/gkone"
    ok "Launcher: $BIN_DIR/gkone"
    if [[ -f "$BIN_DIR/gk" ]]; then
        rm -f "$BIN_DIR/gk"
        info "Removed old $BIN_DIR/gk launcher (renamed to gkone)"
    fi
    case ":$PATH:" in
        *":$BIN_DIR:"*) ;;
        *) warn "$BIN_DIR is not on your PATH — add it in ~/.bashrc or ~/.profile" ;;
    esac

    # ── 5. Application-menu launcher (icon already provided by gkone.desktop) ──
    mkdir -p "$APPMENU_DIR"
    cat > "$APPMENU_DIR/gkone.desktop" <<EOF
[Desktop Entry]
Version=1.0
Type=Application
Name=GKOne
Comment=GKOne Prepaid Card
Exec="$BIN_DIR/gkone" --web
Icon=accessories-calculator
Terminal=false
Categories=Office;Finance;
StartupNotify=false
EOF
    chmod +x "$APPMENU_DIR/gkone.desktop"
    command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database "$APPMENU_DIR" 2>/dev/null || true
    ok "Application-menu entry: GKOne"

    # ── 6. Android sync receiver (optional, always-on) ─────────────────────
    if [[ "$WITH_SYNC" -eq 1 ]]; then
        local UNIT_DIR
        UNIT_DIR="$HOME/.config/systemd/user"
        mkdir -p "$UNIT_DIR"
        sed "s|%h/.local/bin/prepaid-card|$APP_DIR|" "$APP_DIR/prepaid-sync.service" > "$UNIT_DIR/prepaid-sync.service"
        if command -v systemctl >/dev/null 2>&1; then
            systemctl --user daemon-reload
            systemctl --user enable --now prepaid-sync
            ok "Sync receiver enabled as a systemd user service"
        else
            warn "systemctl not found — service unit written but not enabled"
        fi
    else
        info "Sync receiver not enabled (re-run with --install --with-sync, or see README)"
    fi

    echo ""
    echo -e "${G}${W}  Installation complete.${N}"
    echo -e "  ${W}To run:${N} find ${C}GKOne${N} in your applications menu, or from a terminal:"
    echo -e "          ${Y}gkone${N}          — terminal app"
    echo -e "          ${Y}gkone --web${N}    — web app (opens your browser)"
    echo ""
    echo -e "  Installed at :  ${C}$APP_DIR${N}"
    echo -e "  Uninstall    :  ${Y}gkone --uninstall${N}"
    echo ""
}

do_uninstall() {
    set -euo pipefail
    local PURGE=0
    for arg in "$@"; do
        case "$arg" in
            --purge-data) PURGE=1 ;;
            *) die "Unknown option: $arg (see --help)" ;;
        esac
    done

    local BIN_DIR APPMENU UNIT
    BIN_DIR="$HOME/.local/bin"
    APPMENU="$HOME/.local/share/applications/gkone.desktop"
    UNIT="$HOME/.config/systemd/user/prepaid-sync.service"

    echo -e "\n${W}  GKOne Prepaid Card — uninstaller${N}"
    echo    "  ───────────────────────────────────────"

    # ── 1. Sync receiver (systemd service, if enabled) ──────────────────────
    if command -v systemctl >/dev/null 2>&1 && systemctl --user is-enabled prepaid-sync >/dev/null 2>&1; then
        systemctl --user disable --now prepaid-sync 2>/dev/null || true
        ok "Disabled the prepaid-sync systemd service"
    fi
    if [[ -f "$UNIT" ]]; then
        rm -f "$UNIT"
        command -v systemctl >/dev/null 2>&1 && systemctl --user daemon-reload 2>/dev/null || true
        ok "Removed systemd unit"
    fi
    pgrep -f "python.*sync_server\.py" >/dev/null 2>&1 && \
        pkill -f "python.*sync_server\.py" 2>/dev/null && info "Stopped the running sync receiver"

    # ── 2. Application-menu entry ────────────────────────────────────────────
    if [[ -f "$APPMENU" ]]; then
        rm -f "$APPMENU"
        command -v update-desktop-database >/dev/null 2>&1 && \
            update-desktop-database "$HOME/.local/share/applications" 2>/dev/null || true
        ok "Removed application-menu entry"
    else
        info "No application-menu entry found"
    fi

    # ── 3. Launcher ───────────────────────────────────────────────────────────
    if [[ -f "$BIN_DIR/gkone" ]]; then
        rm -f "$BIN_DIR/gkone"
        ok "Removed launcher: $BIN_DIR/gkone"
    else
        info "No launcher found at $BIN_DIR/gkone"
    fi
    [[ -f "$BIN_DIR/gk" ]] && rm -f "$BIN_DIR/gk" && info "Removed old $BIN_DIR/gk launcher"

    # ── 4. Application files ─────────────────────────────────────────────────
    if [[ ! -d "$APP_DIR" ]]; then
        info "Nothing installed at $APP_DIR"
    elif [[ "$PURGE" -eq 1 ]]; then
        rm -rf "$APP_DIR"
        ok "Removed $APP_DIR, including your database"
    else
        find "$APP_DIR" -mindepth 1 ! -name 'prepaid_card.db' ! -name '.sync_token' -delete 2>/dev/null || true
        ok "Removed program files from $APP_DIR"
        [[ -f "$APP_DIR/prepaid_card.db" ]] && warn "Database kept: $APP_DIR/prepaid_card.db"
        [[ -f "$APP_DIR/.sync_token" ]] && warn "Sync token kept: $APP_DIR/.sync_token"
    fi

    echo ""
    echo -e "${G}${W}  Uninstall complete.${N}"
    if [[ "$PURGE" -eq 0 && -d "$APP_DIR" ]]; then
        echo -e "  Your data is still at ${C}$APP_DIR${N} — delete it yourself, or re-run with ${Y}--uninstall --purge-data${N}."
    fi
    echo -e "  The shared virtual environment ${C}~/mybankenv${N} was left in place (other tools may use it)."
    echo ""
}

case "${1:-}" in
    --install)
        shift
        do_install "$@"
        exit 0
        ;;
    --uninstall)
        shift
        do_uninstall "$@"
        exit 0
        ;;
    --help)
        usage
        exit 0
        ;;
esac

cd "$APP_DIR"
source ~/mybankenv/bin/activate

if [ "$1" = "--web" ]; then
    # Also bring up the Android sync receiver, unless one is already running
    # (started manually or via the systemd user unit). Only stop what we start.
    if pgrep -f "python.*sync_server\.py" >/dev/null 2>&1; then
        echo "sync receiver: already running, leaving it alone"
    else
        "$APP_DIR/sync-server" >/tmp/prepaid-sync.log 2>&1 &
        SYNC_PID=$!
        export PREPAID_SYNC_PID="$SYNC_PID"   # app.py kills this on its own shutdown
        trap 'kill "$SYNC_PID" 2>/dev/null' EXIT
        echo "sync receiver: started (pid $SYNC_PID, log /tmp/prepaid-sync.log)"
    fi
    (sleep 1.5 && xdg-open http://localhost:5000 2>/dev/null) &
    python app.py
else
    python prepaid_tracker.py
fi

deactivate
echo
