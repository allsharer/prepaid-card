#!/bin/bash

APP_DIR=~/.local/bin/prepaid-card

if [ "$1" = "--help" ]; then
    echo "Usage: gk [--web] [--help]"
    echo "  (no flag)  Start the terminal app"
    echo "  --web      Start the web app (port 5000) + sync receiver (port 8765)"
    echo "  --help     Show this help"
    exit 0
fi

cd "$APP_DIR"
source ~/mybankenv/bin/activate

if [ "$1" = "--web" ]; then
    # Also bring up the Android sync receiver, unless one is already running
    # (started manually or via the systemd user unit). Only stop what we start.
    if pgrep -f "python.*sync_server\.py" >/dev/null 2>&1; then
        echo "sync receiver: already running, leaving it alone"
    else
        "$APP_DIR/sync-server" >/tmp/prepaid-sync.log 2>&1 &
        SYNC_PID=$!
        export PREPAID_SYNC_PID="$SYNC_PID"   # app.py kills this on its own shutdown
        trap 'kill "$SYNC_PID" 2>/dev/null' EXIT
        echo "sync receiver: started (pid $SYNC_PID, log /tmp/prepaid-sync.log)"
    fi
    (sleep 1.5 && xdg-open http://localhost:5000 2>/dev/null) &
    python app.py
else
    python prepaid_tracker.py
fi

deactivate
echo
